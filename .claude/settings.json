{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh pr create *)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/pr-self-review-gate.sh"
          },
          {
            "type": "command",
            "if": "Bash(gh pr merge *)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/pr-self-review-gate.sh"
          }
        ]
      }
    ]
  }
}
