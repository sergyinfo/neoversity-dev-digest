node_modules/
dist/
# agent-runner ships as a JS GitHub Action — its bundled dist/ MUST be committed
# (GitHub runs action.yml `main: dist/index.js` as-is, with no build step).
!agent-runner/dist/
!agent-runner/dist/**
build/
.next/
out/
coverage/
*.tsbuildinfo
.env
.env.local
.DS_Store
.idea/
.turbo/
.pnpm-store/
*.log
.devdigest/cache/
clones/
playwright-report/
test-results/

# emdash worktree config (local)
.emdash.json

# Agent instructions live in AGENTS.md. CLAUDE.md is a LOCAL symlink to it,
# created by scripts/link-agents.sh (also run by scripts/dev.sh) — never
# committed, so a Windows clone without Developer Mode can't end up with a
# one-line text file where the symlink should be.
CLAUDE.md
