node_modules/
dist/
# agent-runner ships as a JS GitHub Action — its bundled dist/ MUST be committed
# (GitHub runs action.yml `main: dist/index.js` as-is, with no build step).
!agent-runner/dist/
!agent-runner/dist/**
build/
.next/
out/
coverage/
*.tsbuildinfo
.env
.env.local
.DS_Store
.idea/
.turbo/
.pnpm-store/
*.log
.devdigest/cache/
clones/
playwright-report/
test-results/

# emdash worktree config (local)
.emdash.json

# local docker-compose port remap (host 5432 taken by another stack)
docker-compose.override.yml

# skill-eval run output (model runs; conclusions live in skill-evals/history/)
skill-evals/results/

# ~/.gitignore_global excludes .claude/skills; this repo shares its skills with
# the team via version control (see .claude/skills/README.md), so re-include them.
# The directory must be re-included before its contents — git cannot re-include a
# file whose parent directory is excluded.
!.claude/skills/
!.claude/skills/**

# the mini-devdigest fixture is built out of per-package CLAUDE.md files — the
# whole point of it — and the global ignore rule would erase them
!skill-evals/fixtures/**
